# Skopíruj ako .env.local — NIKDY necommituj .env.local.



# Supabase (sync dát — v prihlásení sa nezobrazuje)

NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY



# Google — Web Client ID (Supabase + natívne Android prihlásenie)

NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Len pre prihlásenie v PC prehliadači (Android APK to nepotrebuje)

GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME



# Google Calendar

GOOGLE_CALENDAR_ID=primary



# Capacitor — IP PC servera (npm run android:sync nastaví automaticky)

# CAPACITOR_SERVER_URL=http://192.168.1.10:3000

